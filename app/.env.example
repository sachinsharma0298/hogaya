# Copy to .env.local (on this Mac) and add the same names in Vercel > Settings > Environment Variables.
# NEVER commit real values. Only the two NEXT_PUBLIC_ ones are allowed to reach the browser.

# --- Supabase (Project Settings > API, and > Database) ---
NEXT_PUBLIC_SUPABASE_URL=              # Project URL, e.g. https://abcd1234.supabase.co  (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # "anon" / "publishable" key (public; safe because row-level security is on)
SUPABASE_SERVICE_ROLE_KEY=             # "service_role" / "secret" key. SERVER ONLY. Never give it a NEXT_PUBLIC_ name.
DATABASE_URL=                          # Database > Connection string > SESSION pooler (port 5432, NOT 6543). SERVER ONLY.

# --- Hogaya ---
APP_URL=                               # the public address, e.g. https://hogaya.vercel.app (http://localhost:3000 locally)
OPERATOR_EMAIL=                        # the ONE email that becomes the operator
CRON_SECRET=                           # any long random string; the one-minute timer must send it to /api/tick
AGENT_MODE=demo                        # "real" lets approved numbers get real Fo calls; anything else = simulated calls only
ANTHROPIC_API_KEY=                     # Claude key (turns Fo's call summaries into JSON). SERVER ONLY.
CALL_LANGUAGE=english                  # "english" (default) or "hinglish": the language Fo speaks on calls
NEXT_PUBLIC_CONTACT_EMAIL=             # optional: shown on the "Join as a Pro" page

# --- Local development only (never set these on Vercel) ---
DEV_LOGIN=                             # 1 = a test login so you can try the app without Supabase (refused if DATABASE_URL is set)
FO_DRY_RUN=                            # 1 = rehearsal: the live flow runs but no call is ever made
